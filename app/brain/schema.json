{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ecomOS brand brain record",
  "description": "One fact about one brand in one section. Provenance is optional: only id, brand, section and a value or text are required. See app/contracts/brand-brain.md.",
  "type": "object",
  "required": [
    "id",
    "brand",
    "section"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+\\.[a-z_]+\\.[a-z0-9_.-]+$",
      "description": "brand.section.field or brand.section.field.n for list items"
    },
    "brand": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "section": {
      "type": "string",
      "enum": [
        "identity",
        "diagnosis",
        "story_bank",
        "voice",
        "visual",
        "products",
        "offers",
        "policies",
        "claims",
        "avatars",
        "objections",
        "objection_ladders",
        "language_bank",
        "competitors",
        "positioning",
        "channels",
        "calendar",
        "economics",
        "operations",
        "marketplaces",
        "stack",
        "site_map",
        "content",
        "seo_facts",
        "team",
        "decisions",
        "learnings",
        "open_questions",
        "changes",
        "freshness",
        "plans"
      ]
    },
    "field": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "value": {
      "description": "typed value: number, string, boolean, list or object"
    },
    "text": {
      "type": "string",
      "description": "the fact in one plain sentence, for summaries and packages"
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "ref",
        "captured_at"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "site",
            "ad_library",
            "connector",
            "document",
            "interview",
            "press",
            "review",
            "ticket",
            "founder",
            "agent",
            "inferred"
          ]
        },
        "ref": {
          "type": "string",
          "description": "url, file path, connector table, or record ids for agent and inferred"
        },
        "captured_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "record ids, required when type is agent or inferred"
        }
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "tier": {
      "type": "string",
      "enum": [
        "approved",
        "site_backed",
        "reported",
        "evidence",
        "inferred",
        "unverified",
        "forbidden"
      ],
      "description": "defaults to unverified when absent"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "stale",
        "retired",
        "proposed"
      ],
      "description": "defaults to active when absent"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "description": "defaults to private for founder-added records and public for public sources"
    },
    "valid_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "quote",
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "quote": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "captured_at": {
            "type": "string"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "changed_at"
        ],
        "additionalProperties": true,
        "properties": {
          "value": {},
          "changed_at": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "added_by": {
      "type": "string",
      "description": "who added it, for founder and team notes"
    }
  },
  "anyOf": [
    {
      "required": [
        "value"
      ]
    },
    {
      "required": [
        "text"
      ]
    }
  ]
}
